---
import Base from "../../layouts/Base.astro";
import { practiceAreas, attorneys } from "../../data/site";
---

<Base title="Practice areas" description="The areas of law Whitcombe & Vale practices, from business litigation to estate planning.">
  <header class="page-head">
    <div class="wrap">
      <p class="kicker">Practice areas</p>
      <h1>Six areas of law, each led by a partner who practices it every day</h1>
      <p class="lede">
        We keep our practice focused so that the lawyer you meet is the lawyer who does the work. If your matter falls
        outside these areas, we'll tell you and suggest someone who can help.
      </p>
    </div>
  </header>
  <section class="section">
    <div class="wrap">
      <ol class="areas">
        {
          practiceAreas.map((a, i) => {
            const people = attorneys.filter((p) => p.areas.includes(a.slug));
            return (
              <li>
                <span class="sect">§ {i + 1}</span>
                <div>
                  <h2>
                    <a href={`/practice-areas/${a.slug}`}>{a.name}</a>
                  </h2>
                  <p>{a.summary}</p>
                  <p class="who">{people.map((p) => p.name).join(", ")}</p>
                </div>
                <ul class="matters">
                  {a.matters.slice(0, 4).map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .areas {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .areas > li {
    display: grid;
    grid-template-columns: 64px minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 24px;
    padding-block: 32px;
    border-bottom: 1px solid var(--line);
  }
  .areas > li:first-child {
    border-top: 1px solid var(--ink);
  }
  .sect {
    font-size: 1.5rem;
    line-height: 1.3;
  }
  h2 {
    font-size: 1.75rem;
    margin-bottom: 8px;
  }
  h2 a {
    text-decoration: none;
  }
  p {
    color: var(--ink-2);
    margin-bottom: 8px;
  }
  .who {
    font-size: 0.875rem;
    color: var(--muted);
  }
  .matters {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
    color: var(--ink-2);
    display: grid;
    gap: 8px;
  }
  .matters li {
    padding-left: 16px;
    position: relative;
  }
  .matters li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 6px;
    height: 1px;
    background: var(--muted);
  }
  @media (max-width: 860px) {
    .areas > li {
      grid-template-columns: 48px 1fr;
    }
    .matters {
      grid-column: 2;
    }
  }
</style>
